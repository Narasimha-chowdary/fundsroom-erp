# Server Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Database Connection URL (Prisma)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fundsroom_erp?schema=public"

# Authentication
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_at_least_32_characters
JWT_EXPIRES_IN=7d

# CORS Allowed Origin
CORS_ORIGIN=http://localhost:5173

# Demo Seed Credentials (used only by prisma/seed.ts)
DEMO_USER_PASSWORD=Fundsroom@2026
